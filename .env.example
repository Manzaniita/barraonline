# ==========================================
# BASE DE DATOS (PostgreSQL / Supabase / Neon)
# ==========================================
# URL de conexión con pooling (PgBouncer) para Next.js / Serverless
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# URL directa (sin PgBouncer) para ejecutar migraciones de Prisma
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# CRIPTOGRAFÍA & SEGURIDAD DEL QR
# ==========================================
# Clave secreta fija de 64+ caracteres para firmar los QRs con HMAC-SHA256
QR_SIGNING_SECRET="cambia-este-secreto-por-uno-muy-largo-y-seguro-en-produccion-123456789"

# ==========================================
# REDIS (Upstash - Caché & Idempotencia)
# ==========================================
UPSTASH_REDIS_REST_URL="https://[TU-ID].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[TU-TOKEN-DE-UPSTASH]"

# ==========================================
# MERCADO PAGO OAUTH / SUPER-ADMIN
# ==========================================
MP_CLIENT_ID="[TU-APP-CLIENT-ID-MERCADOPAGO]"
MP_CLIENT_SECRET="[TU-APP-CLIENT-SECRET-MERCADOPAGO]"
NEXT_PUBLIC_APP_URL="https://barraonline.com"
