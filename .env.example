# ==============================================================================
# BARRA ONLINE - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (Supabase / Neon / Postgres)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SEGURIDAD DE SESIÓN & FIRMA CRIPTOGRÁFICA DE QRs (HMAC-SHA256)
# IMPORTANTE: QR_SIGNING_SECRET y AUTH_SECRET deben ser claves distintas de >= 32 bytes (openssl rand -hex 32)
# ------------------------------------------------------------------------------
QR_SIGNING_SECRET="reemplazar-con-clave-hex-64-caracteres-exclusiva-para-qrs"
AUTH_SECRET="reemplazar-con-clave-hex-64-caracteres-exclusiva-para-sesiones"

# ------------------------------------------------------------------------------
# 3. URL PÚBLICA DE LA APLICACIÓN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://barraonline.vercel.app"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 / OPENID CONNECT (OFICIAL)
# ------------------------------------------------------------------------------
# Consola: https://console.cloud.google.com/apis/credentials
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
